{
  "name": "@dsh-local/ui-terminal",
  "description": "CLI-style terminal interface for the DeepSeek Harness web GUI: shadows the built-in root slot with a command-line view over sessions, conversations, tool activity, a workspace file preview card, and a cross-session processing center.",
  "version": "0.5.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "scripts": {
    "build": "node build.js",
    "prepare": "node build.js",
    "test": "node tests/term-render-test.mjs && node tests/term-diag-test.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-web-react": "^0.1.0-rc.6",
    "jsdom": "^25.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "client-plugin",
    "terminal",
    "cli"
  ],
  "license": "MIT"
}
